{
  "name": "noodlestan/conventions",
  "version": "0.0.1",
  "description": "Conventions packages for Noodlestan stack, including Typescript, JSX, Solid JS, and SCSS.",
  "keywords": [
    "conventions",
    "style-guide"
  ],
  "author": "Noodlestan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/conventions.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "prettier": "@noodlestan/prettier-config",
  "scripts": {
    "generate:package-index": "tsx scripts/create-package-index/index.ts",
    "check:package-index": "tsx scripts/check-package-index/index.ts",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "test:scripts": "vitest run --silent=passed-only --coverage --dir scripts/",
    "ci:root": "npm run lint && npm run test:scripts && npm run check:package-index",
    "ci": "npm run ci:root && turbo run ci"
  },
  "devDependencies": {
    "@noodlestan/eslint-config": "0.0.9",
    "@noodlestan/prettier-config": "0.1.1",
    "@noodlestan/tsconfig": "0.2.1",
    "@types/node": "24.13.0",
    "@types/nunjucks": "3.2.6",
    "@vitest/coverage-v8": "5.0.5",
    "lefthook": "2.2.2",
    "nunjucks": "3.2.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
