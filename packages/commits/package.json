{
  "name": "@noodlestan/conventions-commits",
  "version": "0.0.1",
  "description": "Commit conventions for Noodlestan.",
  "keywords": [
    "commits",
    "conventions",
    "style-guide"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/conventions.git",
    "directory": "packages/commits"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "art",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "prettier . -c",
